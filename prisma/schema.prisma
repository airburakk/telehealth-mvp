// Telehealth MVP — veri şeması
// Kapsam: Triyaj + Doktor Paneli + Video görüşme iskeleti

generator client {
  provider      = "prisma-client-js"
  // Yerel: native · Vercel/Linux üretim: rhel-openssl-3.0.x
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // havuzlanmış (pooled) — uygulama çalışma zamanı
  directUrl = env("DIRECT_URL") // havuzsuz (direct) — migration / db push
}

/// Platform kullanıcısı (kimlik doğrulama + rol)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String // PATIENT, DOCTOR, COORDINATOR, ETHICS, ADMIN, PARTNER
  doctorId     String? // DOCTOR rolündeki kullanıcının hekim profili
  partnerId    String? // PARTNER rolündeki kullanıcının Partner Doktor profili (M5 Faz 3)
  sessionVersion Int    @default(0) // JWT iptali: token'daki `sv` claim'i ile karşılaştırılır; artınca eski oturumlar düşer (logout-all / gelecekte şifre değişikliği)
  patientJourney String? // hasta yolculuğu — başvurulan akışta damgalanır (lib/patient-journey): GENERAL | SECOND_OPINION | FREE_CARE | HEALTH_TOURISM; null = henüz başvurmadı → GENERAL nav
  // Profil hafızası (basitleştirme Faz 0, 2026-07-12): "bir kez sor, her yerde kullan" — intake'te
  // girilen değerler buraya yaz-geri edilir (son değer kazanır), sonraki intake'ler prefill eder.
  // Yalnız PATIENT rolünde dolar; telefon KİMLİK verisi → at-rest ŞİFRELİ (lib/crypto encryptField).
  patientCountry     String? // ISO ülke kodu (DZ, TR, ...)
  patientLanguage    String? // dil ADI (air_lang ile aynı sözlük: "Türkçe", "Arapça", ...)
  patientPhone       String? // ŞİFRELİ (enc:v1:...) — decryptField ile okunur
  patientContactPref String? // APP | SMS | EMAIL
  // Sağlık beyanı profil hafızası (sigorta risk formu, 2026-07-20): son beyanın kopyası — sonraki
  // vakada prefill. Özel nitelikli sağlık verisi → at-rest ŞİFRELİ JSON (encryptField).
  patientHealthHistory String? // ŞİFRELİ JSON {chronic:string[], meds:bool, smoking:bool, majorSurgery:bool}
  // E-posta doğrulama (Auth Faz 5, v5.6 — RESEND_API_KEY yoksa DORMANT): null = doğrulanmamış YENİ
  // e-posta kaydı (girişi engellenir). Mevcut hesaplar migration'da damgalandı; dormant modda ve
  // Google girişlerinde kayıt anında damgalanır (Google e-postayı zaten doğrulamış olur).
  emailVerifiedAt      DateTime?
  emailVerifyTokenHash String? // aktif doğrulama token'ının sha256'sı (ham token yalnız e-postadaki bağlantıda)
  emailVerifySentAt    DateTime? // son doğrulama e-postası zamanı (yeniden-gönder soğuması + 24s token TTL tabanı)
  /// Apple ile Giriş (v6.82) — Apple'ın kalıcı kullanıcı kimliği (ID token `sub`). E-POSTA DEĞİL:
  /// kullanıcı "E-postamı Gizle"yi seçerse bize @privaterelay.appleid.com adresi gelir ve o adres,
  /// uygulama Apple ID'den kaldırılıp yeniden bağlanınca DEĞİŞİR → yalnız e-postaya bakan eşleme
  /// aynı kişiye ikinci hesap açardı. `sub` opaktır, kimlik taşımaz (şifrelenmez — unique index gerekir).
  /// ⚠️ Hesap silmede NULL'lanır (lib/account-deletion): aksi halde silinmiş kabuk, Apple girişiyle canlanırdı.
  appleSub             String?   @unique
  // Hesap silme (v6.11 — lib/account-deletion): damgalıysa kişisel alanlar (email/name/patient*) ZATEN
  // boşaltılmış + parola çöpe atılmış + sessionVersion artırılmıştır → giriş imkânsız, kişisel veri gitmiştir.
  // ⚠️ Satır neden hemen SİLİNMİYOR: sakladığımız klinik kayıtların RIZASINI ispat eden ConsentRecord.userId
  // bağı kopmasın (yasal saklama süresi boyunca "bu kaydı neden tutuyoruz"un kanıtı). Süre dolunca
  // (Case.purgeAfter) kabuk da imha edilir → o an gerçekten hiçbir şey kalmaz.
  deletedAt    DateTime?
  // Kurumsal üyelik doğrulaması (2026-08-12): PARTNER/AGENCY/HEALTH_PRO self-signup hesapları null
  // açılır; /admin/personel-onay insan onayı damgalar. Damgasız hesap rol paneline giremez
  // (/kayit/durum'a iner). DOCTOR bu alana BAKMAZ (kendi üç-damga sistemi: verified/activatedAt/
  // chamberLetterAt). Mevcut personel hesapları migration'da damgalandı (demo/seed kırılmasın).
  staffVerifiedAt DateTime?
  createdAt    DateTime @default(now())

  @@index([deletedAt]) // imha cron'u: süresi dolan silinmiş hesapları tarar
  @@index([doctorId]) // doktor-hedefli bildirim/atama lookup'ları (lib/notify, clinical-duty, SO)
  @@index([partnerId]) // partner-hedefli bildirimler (konsültasyon yanıt/mesaj/video)
}

/// M5 Faz 3 — Partner Doktor: yurtdışından sisteme katılan, hasta yönlendiren ortak hekim.
/// Uzaktan sağlık hizmeti VERMEZ ve platform hasta veritabanına ERİŞEMEZ (ayrı tablo, ilişki yok).
/// Tek yetkisi: kendi yönlendirdiği hastanın bilgisini ANONİMLEŞTİREREK konsültasyon talebi açmak.
model PartnerDoctor {
  id          String   @id @default(cuid())
  name        String
  title       String   @default("Dr.")
  country     String // ISO ülke kodu (yurtdışı) — DE, RU, AT ...
  institution String? // kurum/klinik adı
  branch      String? // ana branş (varsa)
  email       String   @unique
  phone       String?
  language    String?  @default("İngilizce") // partner doktorun kendi okuma dili (haber akışı + arayüz çevirisi)
  verified    Boolean  @default(false)
  lastSeenAt  DateTime? // Faz 3 presence/heartbeat — son aktiflik (online tespiti için)
  createdAt   DateTime @default(now())
}

/// KVKK/açık onam kaydı — kullanıcı bazlı, sürümlü (Consent Manager Faz 0).
/// Bir kez alınır; CONSENT_VERSION (lib/consent-config) artarsa kullanıcı bir kez yeniden onaylar.
/// scope ileride genişleyebilir (ör. ülkeye/işleme özel ayrı kapsamlar).
model ConsentRecord {
  id        String   @id @default(cuid())
  userId    String
  scope     String   @default("GENERAL_KVKK")
  version   Int
  grantedAt DateTime @default(now())
  ip        String?
  // İspat & bütünlük katmanı (RFC 3161 onam-ispat — dijital-onam-zaman-damgasi). Eski kayıtlar null (geriye dönük backfill yok).
  textHash    String? // onaylanan metnin (CONSENT_TEXT, o sürüm) SHA-256 hash'i
  userAgent   String? // cihaz / tarayıcı (User-Agent)
  channel     String  @default("WEB") // WEB | MOBILE | SMS_OTP ... (çok-kanallı onam)
  prevHash    String? // bir önceki kaydın entryHash'i (append-only hash-zinciri) — GENESIS=ilk
  entryHash   String? // SHA-256(userId|scope|version|textHash|ip|ua|grantedAt|prevHash) — bu kaydın mührü
  tsAuthority String? // zaman damgası otoritesi (şimdilik SIMULATED-LOCAL; üretim = RFC 3161 TSA — hukuk)
  tsTime      DateTime? // TSA'nın güvenilir zamanı
  tsToken     String? // imzalı zaman damgası token'ı (entryHash üzerinde)
  // Bağ-koruyan imha (kabuk purge'u): damgalıysa ip/userAgent BOŞALTILMIŞTIR (kişisel veri imhası;
  // kalan userId cuid'i User satırı silindiği için anonimdir). Satır zincir HALKASI olarak durur —
  // fiziksel silme append-only zinciri kırardı. verifyConsentChain purged satırda mührü atlar, bağı sürdürür.
  purgedAt    DateTime?

  @@unique([userId, scope, version])
}

/// Kurumsal üyelik başvurusu (2026-08-12) — PARTNER / AGENCY / HEALTH_PRO self-signup soru seti.
/// answers KİŞİSEL VERİ taşır (ad, telefon, kurum, tescil no...) → at-rest ŞİFRELİ JSON (encryptField);
/// çözme YALNIZ personel-onay incelemesinde (sunucuda). Kullanıcı başına TEK başvuru (@unique):
/// REJECTED başvuru düzeltilip yeniden gönderilir (status→PENDING), yeni satır açılmaz.
/// COORDINATOR/ETHICS başvuru almaz — yalnız davet (scripts/create-staff.ts).
model StaffApplication {
  id               String    @id @default(cuid())
  userId           String    @unique
  role             String // başvurulan rol: PARTNER | AGENCY | HEALTH_PRO
  answers          String // ŞİFRELİ JSON — rol-config soru seti yanıtları (lib/staff-application)
  status           String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedByUserId String? // onay/ret veren personel (audit eşleniği AccessLog'da)
  reviewedAt       DateTime?
  reviewNote       String? // ret gerekçesi / onay notu — başvurana gösterilir (kişisel veri içermez)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, createdAt]) // personel-onay kuyruğu: PENDING'ler tarihe göre
}

/// Kurumsal başvuru belgesi — DoctorDocument deseninin eşleniği (base64 data URI, at-rest şifreli).
/// Tip sözlüğü rol-config'te (lib/staff-application): PARTNER=LICENSE · AGENCY=TURSAB/AUTHORITY ·
/// HEALTH_PRO=DIPLOMA. Yükleme /kayit/durum'dan (oturumlu), indirme yalnız personel-onay incelemesinde.
model StaffDocument {
  id            String   @id @default(cuid())
  applicationId String
  type          String // rol-config zorunlu belge tipi anahtarı
  label         String // dosya adı
  mimeType      String // application/pdf | image/jpeg | image/png | ...
  content       String // base64 data URI — at-rest şifreli (encryptField)
  createdAt     DateTime @default(now())

  @@index([applicationId])
}

/// Platformdaki uzman hekim
model Doctor {
  id            String         @id @default(cuid())
  name          String
  title         String // Prof. Dr., Doç. Dr., Op. Dr., Uzm. Dr.
  branch        String
  city          String
  languages     String // CSV: "Türkçe,Rusça,İngilizce"
  markets         String? // M5: hekimin hizmet verdiği pazarlar — CSV ISO kod "RU,DE,DZ" (boş = tümü)
  // v4.19 veri dürüstlüğü: pazarlama-değerli uydurma @default'lar KALDIRILDI (yeni doktor "4.7★/JCI'lı"
  // doğmasın — sağlık reklamı mevzuatı). null = "veri yok" → UI gizler, eşleştirme metriği inactive olur.
  // Mevcut (demo) satırların değerleri migration'da KORUNDU; demo zenginliği seed'in AÇIK değerlerinden gelir.
  verified        Boolean        @default(false) // güvenlik kapısı — yalnız admin onayı true yapar (kazara-doğrulanmış create riski kapandı)
  bio             String?
  color           String         @default("#16467a")
  rating          Float? // gerçek Review agregasyonu bağlanana kadar yalnız seed/elle veri
  successRate     Int?
  experienceYears Int?
  jci             Boolean? // doğrulanmış akreditasyon belgesi girilince true — asla varsayılan değil
  capacity        Int            @default(20) // aylık işlem kapasitesi (operasyonel varsayılan; preferences 1-200 clamp'li)
  procedures      String? // M5: doktorun yaptığı işlemler + kendi fiyatı — JSON {"<kod>": <fiyat₺>}
  licenseNo       String? // FHIR Faz 0: hekim diploma/tescil no → Practitioner.identifier
  // M6 Akademik & Eğitim — kalıcı profil (boşsa lib/doctor-profile.ts deterministik üretim fallback eder)
  eduSchool       String? // mezun olunan tıp fakültesi
  eduYear         Int? // mezuniyet yılı
  specBoard       String? // uzmanlık belgesi / yan dal adı
  specYear        Int? // uzmanlık (belge) yılı
  certifications  String? // JSON string[] — mesleki sertifika/üyelikler
  publications    String? // JSON [{title,venue,year}] — akademik yayın/çalışmalar
  photo           String? // profil fotoğrafı yolu (ör. /photos/pool/p07.jpg ya da public Blob URL'i); yoksa cinsiyet-fallback (DoctorArt)
  /// Profil tanıtım videosu (2026-08-14) — YouTube/Vimeo URL'i YA DA public Blob URL'i (client-upload).
  /// ≤60 sn kuralı İSTEMCİDE doğrulanır (sunucu süre ölçemez — ffmpeg yok); gerçek tavan Blob 50MB sınırı.
  introVideo      String?
  // M5 Doktor Ana Sayfa onboarding & pencere görünürlüğü (lib/doctor-home.ts)
  onboardedAt        DateTime? // ilk-giriş onboarding kapısı tamamlandı mı (null = /doktor/baslangic'a yönlendir)
  freeCareOptIn      Boolean   @default(false) // Ücretsiz Sağlık Hizmeti vakası kabul ediyor mu → Ana Sayfa penceresi görünürlüğü (anlık müsaitlik = freeCareState ayrı)
  consultOptIn       Boolean   @default(false) // Partner konsültasyon taleplerini yanıtlıyor mu → Konsültasyon Talepleri penceresi görünürlüğü (yanıt başına ödeme, simüle)
  /// Doctorium (v6.48) — hekimin haber akışında görmek istediği branş SLUG'ları. JSON string[].
  /// null/boş = yalnız kendi branşı (varsayılan davranış, tercih ekranına hiç girmemiş hekim).
  newsBranches       String?
  /// Doctorium Akış Tercihleri (Faz 2, 2026-08-14) — Akışım'a hangi BÖLÜMLER girsin. JSON string[]
  /// ("akademik" | "sektorel" | "ilac" | "mevzuat" | "kongre" | "kariyer"). null/boş = TÜMÜ
  /// (tercih ekranına hiç girmemiş hekim her bölümü görür — daraltma bilinçli seçimdir).
  feedModules        String?
  /// Doctorium kongre alarmı (v6.49): takip edilen kongrenin BAŞLANGICINDAN kaç gün önce
  /// hatırlatılsın. null = alarm kapalı. Hatırlatma günlük bakım cron'unda gönderilir.
  congressAlertDays  Int?
  /// Doctorium kongre alarmı (v6.49): bildiri teslim / erken kayıt SON TARİHİNDEN kaç gün önce.
  /// null = kapalı. Son tarih alarmı ayrı tutulur — kongreye 30 gün varken bildiri süresi dolabilir.
  /// 🔄 v6.62'de İKİYE AYRILDI (aşağıdaki iki alan). Bu alan geriye-uyum için DURUYOR: eski değer
  /// migration'da iki yeni alana kopyalandı; yeni kod yalnız yeni alanları okur.
  congressDeadlineAlertDays Int?
  /// v6.62: BİLDİRİ son gönderim tarihinden kaç gün önce uyarılsın. null = kapalı.
  /// Ayrı eşik: bildiri hazırlamak haftalar sürer, erken kayıt ise tek işlemdir — aynı gün sayısı
  /// ikisine de doğru gelmiyordu (kullanıcı isteği). Eşik her kongrenin KENDİ tarihine uygulanır.
  congressAbstractAlertDays  Int?
  /// v6.62: ERKEN KAYIT son tarihinden kaç gün önce uyarılsın. null = kapalı.
  congressEarlyBirdAlertDays Int?
  /// Doctorium sponsorlu içerik KİŞİSELLEŞTİRME açık rızası (v6.68 Faz 1): dolu = rıza verildi
  /// (verildiği an); null = yok/geri alındı → doktora yalnız hedefsiz (bağlamsal) kampanya gösterilir.
  /// Durumun tek kaynağı bu alan; İSPAT izi ConsentRecord'da (scope SPONSOR_TARGETING — grant/revoke
  /// ayrı satırlar, lib/sponsor.ts). Reklamverene hiçbir kişisel veri gitmez (agregat sayaç yalnız).
  sponsorPersonalizationAt DateTime?
  /// İki aşamalı giriş — AŞAMA 1 damgası (v6.87): tabip odası "Protokol Numaralı" üye yazısı
  /// (DoctorDocument.type = CHAMBER) yüklüyse dolu → yalnız Doctorium erişimi açılır (otomatik,
  /// admin onayı beklemez — kullanıcı kararı 2026-08-11). Klinik havuz kapısı (activatedAt) AYRI
  /// ve DEĞİŞMEDİ. Erişim kuralı kodda: chamberLetterAt VEYA activatedAt (lib/doctor-activation.ts
  /// hasDoctoriumAccess) — mevcut aktif doktorlar backfill'siz geçer.
  chamberLetterAt          DateTime?
  /// Tıp öğrencisi damgası (v6.95): e-Devlet öğrenci belgesi (DoctorDocument.type = STUDENT_CERT)
  /// yüklüyse dolu → yalnız Doctorium İÇERİK erişimi (CHAMBER deseni — otomatik, admin onayı yok).
  /// Klinik kapı (activatedAt) ve pazarlama yüzeyleri (sponsor/anket/ödül — isStudentOnly süzgeci)
  /// KAPALI kalır: öğrenci sağlık meslek mensubu değildir, tanıtım rejimi ona uygulanamaz.
  /// Mezuniyette diploma+MMSS yüklenince activatedAt dolar → süzgeç kendiliğinden kalkar.
  studentVerifiedAt        DateTime?
  /// Öğrenci YOLU işareti (v6.95): /ogrenci hunisinden açılan hesap true doğar — belge henüz
  /// yüklenmemişken bile onboarding öğrenci modunda kalır (klinik belge/MMSS blokları HİÇ
  /// gösterilmez) ve HealthTürkiye dizin doğrulaması atlanır (öğrenci dizinde olmaz — yanlış
  /// NOT_FOUND bayrağı üretme). Erişimi AÇMAZ (kapı daima studentVerifiedAt/activatedAt).
  studentTrack             Boolean   @default(false)
  /// İnsan kaynakları iletişim izni (v6.87, opt-in — hizmete ŞART DEĞİL): dolu = doktor, İK
  /// uzmanlarının kendisiyle iletişime geçmesine açık onam verdi; null = yok/geri alındı.
  /// İSPAT izi ConsentRecord'da (scope HR_CONTACT / HR_CONTACT_REVOKE — lib/hr-consent.ts).
  /// İK modülü henüz YOK — onam şimdiden toplanır, modül geldiğinde yalnız dolu olanlar listelenir.
  hrContactOptInAt         DateTime?
  // Ücretsiz Sağlık Hizmeti — anlık müsaitlik + kontenjan (gönüllü ücretsiz konsültasyon).
  freeCareState       String    @default("OFFLINE") // OFFLINE | AVAILABLE | IN_SESSION
  freeCareQuota       Int       @default(10) // dönem (takvim haftası) başına kontenjan
  freeCareUsed        Int       @default(0)
  freeCareResetAt     DateTime? // kontenjan dönem başlangıcı
  freeCareAvailableAt DateTime? // en son AVAILABLE olunan an (eşleştirme sırası / stale tespiti)
  // Klinik nöbet/müsaitlik — 3-seçenek kapısı (§8 mahremiyet/akış): Branş online · İcapçı (icap) · Nöbetçi (7/24 genel)
  clinicalState       String    @default("OFFLINE") // OFFLINE | ONLINE | IN_SESSION — Branş/Nöbetçi gerçek-zaman klinik mevcudiyeti
  onCall              Boolean   @default(false) // İcapçı: offline ama randevu (icap) açık
  sentinel            Boolean   @default(false) // Nöbetçi yetkisi (7/24 genel/Dahiliye/Acil havuzu)
  clinicalAvailableAt DateTime? // en son ONLINE olma anı (eşleştirme sırası)
  // CRM eşleştirme kalite indikatörleri (metadata; klinik içerik değil → şifreleme uyumlu) — lib/match-score.ts
  icapNotified    Int            @default(0) // İcapçı olarak alınan randevu talebi bildirimi sayısı
  icapOffered     Int            @default(0) // bu taleplere verilen randevu teklifi sayısı → icap dönüş oranı = offered/notified
  // Yanıt süresi (duyarlılık) — İcapçı talebe ne kadar hızlı teklif veriyor: ort = respTotalSec/respCount (additive sayaç)
  respCount       Int            @default(0) // yanıtlanan (teklif verilen) İcapçı talebi sayısı
  respTotalSec    Int            @default(0) // toplam yanıt süresi (saniye) — talep→teklif
  lastSeenAt      DateTime? // Faz 3 presence/heartbeat — son aktiflik (konsültasyon video online tespiti)
  // M5 — Mesleki belge yükleme + aktivasyon kapısı (diploma + MMSS zorunlu; yüklemeden hesap aktifleşmez)
  activatedAt          DateTime? // zorunlu belgeler tamam → hesap aktif; null = /doktor/baslangic'a yönlendir
  // Zorunlu Mesleki Mali Sorumluluk Sigortası (MMSS) özeti — M3 Katman 3 malpraktis ek-prim girdisi
  mmssInsurer          String? // sigorta şirketi
  mmssPolicyNo         String? // poliçe no (at-rest şifreli — encryptField)
  mmssCoverageLimit    Int? // teminat limiti (mmssCoverageCurrency biriminde)
  mmssCoverageCurrency String?   @default("TRY") // "TRY" | "USD" — hesapta canlı kurla USD'ye normalize edilir
  /// Faz 1b kararları (2026-08-14 — vault output/doktor-belge-kontrol-tasarimi): ROZET-ONLY —
  /// süre dolunca sistem ENGELLEMEZ, hekim-onay ekranı uyarı rozeti gösterir. Yalnız YENİ kayıtta
  /// zorunlu (form alanı beklemede; /api/doctor/mmss zaten opsiyonel kabul eder); mevcut hekimde
  /// boş kalabilir — doldurma bildirimi/yaptırımı bilinçli YOK (kullanıcı kararı).
  mmssValidUntil       DateTime? // poliçe geçerlilik bitişi
  mmssVerifiedAt       DateTime? // operasyon/admin doğrulaması (ileride; şimdilik yüklemeyle damgalanır)
  // 2026-07-10 — bildirim kanalı tercihi + HealthTürkiye kayıt doğrulaması
  phone             String? // cep telefonu (at-rest şifreli, encryptField) — WhatsApp/SMS bildirim hedefi
  notifyChannel     String    @default("APP") // bildirim kanalı: APP | WHATSAPP | SMS (WA/SMS dormant — env yoksa simülasyon)
  registryStatus    String? // healthturkiye.gov.tr doğrulaması: FOUND | NOT_FOUND (null = henüz bakılmadı) → etik kurul onay bayrağı
  registryCheckedAt DateTime? // son doğrulama zamanı
  cases           Case[]
  consultations   Consultation[]
  reviews         Review[]
  documents       DoctorDocument[]
  createdAt       DateTime       @default(now())
}

/// Doğrulanmış hasta yorumu (Modül 6)
model Review {
  id        String   @id @default(cuid())
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  doctorId  String
  author    String
  country   String
  stars     Int
  text      String
  createdAt DateTime @default(now())

  @@index([doctorId, createdAt]) // public doktor profili (liste, createdAt desc) + bekleme odası count + CRM groupBy
}

/// Triyajdan geçen hasta vakası
model Case {
  id                  String         @id @default(cuid())
  userId              String? // vaka sahibi hasta (User.id) — hasta yalnız kendi vakalarını görür
  patientName         String
  country             String // DZ, LY, RU, KZ, KG, TR ...
  language            String
  // FHIR Faz 0: hasta stabil kimliği → Patient.identifier (içsel cuid korunur)
  patientIdentifier     String? // TC Kimlik / pasaport no (varsa)
  patientIdentifierType String? // "TC" | "PASSPORT" | ...
  symptoms            String
  durationText        String?
  extra               String? // branşa özel yanıtların JSON'u
  attachments         String? // CSV dosya adları
  branch              String
  urgency             Int // 1-5
  reasoning           String
  confidence          Int            @default(70) // 0-100
  status              String         @default("NEW") // NEW, IN_REVIEW, IN_CONSULT, DONE
  // Ön-konsültasyon ücret/sigorta kapısı (Modül 1)
  consultFee          Int? // tahsil edilen görüşme ücreti (USD)
  payStatus           String         @default("PENDING") // PENDING, PAID, INSURED
  payMethod           String? // PAYMENT | INSURANCE
  policyNo            String? // sigorta poliçe no (INSURANCE ise)
  payRef              String? // ödeme referansı (PAYMENT ise, simüle)
  // AI Epikriz / Taburcu Raporu — hastanın tüm yolculuğunun klinik döküman sentezi
  dischargeReport     String? // AI ile üretilen epikriz tam metni (başlık + bölümler)
  dischargeStructured String? // JSON: yapılandırılmış bölümler (tanı, anamnez, ...)
  dischargeAt         DateTime? // epikrizin oluşturulma zamanı
  icd10Code           String? // FHIR Faz 0: tanı ICD-10 kodu → Condition.code (kodlu; yoksa metin)
  labResults          String? // FHIR Faz 2: laboratuvar sonuçları JSON [{loinc,name,value,unit}] → Observation
  // M2→M3: doktorun görüşmede tavsiye ettiği tedaviler (KSHFT kodları + doktorun ₺ fiyatı)
  recommendedProcedures String? // JSON [{code,name,priceTRY}]
  // Ücretsiz Sağlık Hizmeti — ücretsiz konsültasyon akışı (mevcut Case yeniden kullanılır; normal vakada false/null).
  freeCare            Boolean        @default(false)
  freeCareStatus      String? // WAITING|MATCHED|IN_CONSULT|CONSULT_DONE|TREATMENT_NEEDED|ETHICS_REVIEW|ETHICS_REJECTED|ETHICS_APPROVED|COMPLETED|CANCELLED (hasta sıradan çekildi, Faz 4)
  // Sağlık Turizmi (Faz 2) — hasta /saglik-turizmi tercihleri JSON {tier,nights,country,branch}; normal vakada null.
  // LOJİSTİK tercih (PHI DEĞİL, düz metin — decryptCaseFields kapsamı DIŞI); doktor PackageBuilder'ı ön-doldurur.
  // tourismPlan != null aynı zamanda "turizm vakası" ayırt edicisidir (ek boolean gereksiz).
  tourismPlan         String?
  // Belge-bekleyen başvuru (2026-07-24, kullanıcı kararı): triyajda eksik zorunlu belgeyle (docAck)
  // oluşturulan aciliyet ≤3 vaka status=DOCS_PENDING doğar ve doktor havuzuna DÜŞMEZ; hasta vaka
  // merkezinde kalemleri yükleyip işaretleyince NEW'e geçer (bildirimler o anda). Bekleyen kalem
  // ETİKETLERİNİN JSON dizisi (requiredDocs kataloğu — PHI değil, düz; branch ile aynı sınıf). null = yok.
  pendingDocs         String?
  // 2026-07-10 değişiklik paketi — hasta iletişim + tedavi kararı + STA iletimi + epikriz talebi
  patientPhone         String? // hasta telefonu (kimlik → at-rest şifreli, encryptField)
  contactPreference    String? // hastanın iletişim tercihi: APP | SMS | EMAIL
  // Sağlık beyanı (sigorta risk formu, 2026-07-20): hastanın paket ekranında verdiği beyan — prim
  // hesabına endikatif risk çarpanı olarak girer (lib/pricing computeHealthRiskMult). Vaka anına
  // SABİT (denetlenebilirlik: prim hangi beyanla hesaplandı); profil kopyası User.patientHealthHistory.
  // Özel nitelikli sağlık verisi → at-rest ŞİFRELİ JSON (decryptCaseFields kapsamında).
  healthDeclaration    String? // ŞİFRELİ JSON {chronic:string[], meds:bool, smoking:bool, majorSurgery:bool}
  healthDeclaredAt     DateTime? // beyanın verildiği/güncellendiği an (null = beyansız → çarpan 1.0)
  treatmentDaysMin     Int? // doktorun öngördüğü tedavi süresi — alt sınır (gün)
  treatmentDaysMax     Int? // üst sınır (gün); örn. 3–7 gün
  hospitalRegistryId   Int? // tedavi için seçilen hastane (RegistryHospital.id — gevşek bağ, FK yok)
  hospitalName         String? // hastane adı snapshot'ı (registry kaydı kalksa da dosyada kalır)
  agencySentAt         DateTime? // tedavi kararının Sağlık Turizmi Acentesine iletildiği an (null = iletilmedi)
  dischargeRequestedAt DateTime? // hastanın post-op ekranından epikriz/taburcu raporu talebi
  // Hesap silme (v6.11 — lib/account-deletion). Hasta hesabını silince klinik kayıt SİLİNMEZ (yasal
  // saklama yükümlülüğü) ama ERİŞİME KAPANIR: deletionLockedAt damgalıysa canCaseBeAccessedBy HERKESE
  // false döner (ADMIN/COORDINATOR/ETHICS geniş dalları dahil). purgeAfter = saklama süresi sonu →
  // cron o tarihten sonra kaydı GERÇEKTEN imha eder (satır + belgeler + rıza + hesap kabuğu).
  // Post-op daraltmadan (postop-access, Faz 2A) FARKI: bu geri alınamaz ve hastayı da kapsar.
  deletionLockedAt     DateTime?
  purgeAfter           DateTime?
  doctor              Doctor?        @relation(fields: [doctorId], references: [id])
  doctorId            String?
  consultations       Consultation[]
  bookings            Booking[]
  recovery            Recovery?
  complaints          Complaint[]
  shareLinks          ShareLink[]
  documents           CaseDocument[]
  createdAt           DateTime       @default(now())

  @@index([userId])
  @@index([purgeAfter]) // imha cron'u: süresi dolan kayıtları tarar
  @@index([freeCare, freeCareStatus])
  @@index([doctorId]) // doktor kokpit OR-dalı + ücretsiz-hizmet kokpiti + CRM groupBy'lar
  @@index([branch, status]) // kokpit branş-dalı (status IN) + personel kuyruğu /api/cases?branch=&status=
  @@index([agencySentAt]) // STA kuyruğu: agencySentAt != null (acente yalnız iletilen dosyaları görür)
}

/// M5 Faz 2 — Partner doktorun açtığı anonimleştirilmiş konsültasyon talebi.
/// Hiçbir kişisel veri taşımaz (lib/deidentify.ts ile arındırılır); kayıtlı hekimler görüş verir.
/// clinicalSummary + answerText klinik içerik → at-rest şifreli (lib/crypto encryptField).
model ConsultationRequest {
  id                 String    @id @default(cuid())
  sourceCaseId       String? // iç izlenebilirlik (hangi vakadan türetildi) — yanıtlayan hekime ASLA gösterilmez
  requestedByPartnerId String? // talebi açan Partner doktor (M5 Faz 3) — kendi taleplerini/yanıtlarını görür
  requestedByDoctorId String? // talebi İÇ VAKADAN açan platform doktoru (v6.33 Faz 3) — kendi talebi havuzunda GÖSTERİLMEZ; yanıt vaka sayfasına düşer
  requestedByName    String? // talebi açan doktorun görünen adı (UI gösterimi)
  branch             String? // null = genel havuz · dolu = yalnız bu branş hekimleri görür
  region             String // ülke/bölge (kaba bağlam; bireysel tanımlayıcı değil)
  language           String
  urgency            Int       @default(3)
  icd10Code          String? // tanı kodu (varsa)
  clinicalSummary    String // anonim klinik özet (at-rest şifreli)
  summaryTr          String? // klinik özetin Türkçe çevirisi — yanıtlayan hekim için (at-rest şifreli, cache)
  status             String    @default("OPEN") // OPEN | IN_DISCUSSION | ANSWERED (Faz 2: hekim soru sorunca sahiplenir)
  engagedByDoctorId  String? // talebi ilk sahiplenen hekim (soru sorunca; answer'da answeredByDoctorId ile aynı) — Faz 2 chat
  answeredByDoctorId String? // görüş veren hekim
  answerText         String? // hekim görüşü (at-rest şifreli)
  answerTr           String? // hekim görüşünün hasta diline çevirisi — partnere dönüş (at-rest şifreli)
  // Yapılandırılmış FHIR öneriler (hekim görüşe ek olarak verir) — JSON, kodlu
  recommendedLabs    String? // JSON [{loinc,name}] → FHIR ServiceRequest (lab order, LOINC)
  recommendedImaging String? // JSON [{code,system,name}] → FHIR ServiceRequest (görüntüleme)
  medications        String? // JSON [{atc,name,dose,route,freq}] → FHIR MedicationRequest (ATC zorunlu)
  paymentSim         Int? // yanıt başına ödeme (USD, simüle)
  answeredAt         DateTime?
  createdAt          DateTime  @default(now())
  documents          ConsultationRequestDocument[]
  messages           ConsultationMessage[]

  @@index([status, branch])
  @@index([requestedByPartnerId])
  @@index([answeredByDoctorId]) // doktor "yanıtladıklarım" listesi (/doktor/konsultasyon her yüklemede)
}

/// M5 Faz 2 — Konsültasyon talebine bağlı yazılı görüşme (chat) mesajı.
/// Partner ↔ sahiplenen/yanıtlayan hekim. body = gönderenin kaynak dili; translated = alıcının dili
/// (DOCTOR→partner dili · PARTNER→Türkçe; AI translateText). İkisi de at-rest şifreli (lib/crypto).
model ConsultationMessage {
  id         String              @id @default(cuid())
  request    ConsultationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId  String
  senderRole String // "PARTNER" | "DOCTOR"
  body       String // gönderenin kaynak dili — at-rest şifreli
  translated String? // alıcının dilindeki çeviri — at-rest şifreli (TR↔TR ise null)
  readAt     DateTime?
  createdAt  DateTime            @default(now())

  @@index([requestId, createdAt]) // mesaj poll'u (8 sn) — filtre + sıralamayı tek index'ten karşılar
}

/// M5 Faz 3 — Konsültasyon görüntülü görüşme randevusu (İcapçı offer/respond deseni).
/// Gevşek bağ (FK YOK — anonim): requestId/doctorId/partnerId düz String. Sinyalleşme kanalı = bu kaydın id'si
/// (api/consultations/[id]/signal callerSide üçüncü kanal olarak tanır). Taraflar: sahiplenen hekim + partner.
model ConsultationVideoAppointment {
  id          String    @id @default(cuid())
  requestId   String // ConsultationRequest.id (gevşek bağ — anonim)
  doctorId    String // sahiplenen/yanıtlayan hekim (Doctor.id)
  partnerId   String // talebi açan partner (PartnerDoctor.id)
  proposedAt  DateTime // hekimin önerdiği zaman
  scheduledAt DateTime? // partner onaylarsa kesin zaman
  status      String    @default("OFFERED") // OFFERED | SCHEDULED | DECLINED | COMPLETED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([requestId])
  @@index([doctorId])
  @@index([partnerId])
}

/// M5 — Konsültasyon talebine eklenen anonim tıbbi belge + triyaj-tipi AI değerlendirme sonucu.
/// fileData/aiSummary/aiTranslation/aiFlags at-rest şifreli (lib/crypto).
/// Yanıtlayan hekim AI-çıkarımı klinik içeriği görür; ham dosya hekime gösterilmez (anonimlik).
/// İSTİSNA — DICOM (v6.32): mime=application/dicom belgeler kayıt ÖNCESİ PHI tag-strip'ten geçer
/// (lib/dicom-deidentify) → anonim ham dosya auth'lu /raw ucundan DicomViewer'da GÖSTERİLİR;
/// AI değerlendirme DICOM'a uygulanmaz (viewer-only).
model ConsultationRequestDocument {
  id            String              @id @default(cuid())
  request       ConsultationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId     String
  label         String // dosya adı/etiketi
  mime          String // application/pdf | image/*
  fileData      String // base64 data URL / blob ref — at-rest şifreli; DICOM = tag-strip'li anonim dosya (v6.32)
  docType       String? // assessDocument türü (Laboratuvar/Radyoloji/Epikriz/...)
  aiSummary     String? // klinik özet (TR) — şifreli
  aiTranslation String? // belge içeriği TR çeviri — şifreli
  aiFlags       String? // anormal/kritik bayraklar — şifreli
  aiLabs        String? // JSON [{loinc,name,value,unit}] → FHIR Observation
  assessedAt    DateTime?
  createdAt     DateTime            @default(now())

  @@index([requestId])
}

/// Hasta-doktor video görüşmesi
model Consultation {
  id        String    @id @default(cuid())
  case      Case      @relation(fields: [caseId], references: [id])
  caseId    String
  doctor    Doctor    @relation(fields: [doctorId], references: [id])
  doctorId  String
  notes     String    @default("")
  status    String    @default("ACTIVE") // ACTIVE, ENDED
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([doctorId, status]) // doktor konsolu + pro-bono doctor-feed poll'ları (aktif görüşme var mı)
  @@index([caseId]) // hasta bekleme poll'u + vaka ilişki yükleri + outcome/terminate güncellemeleri
}

/// İcapçı randevu akışı — "online doktor yoksa 3-seçenek kapısı" Seçenek 2 (§3.2 mahremiyet/akış).
/// Hasta "Branş randevusu" seçince oluşur; branştaki İcapçı hekimlere düşer, ilk teklif eden atomik
/// kapar (REQUESTED→OFFERED), hasta onay/değişiklik verir (SO Part B deseni). Case.id ile gevşek bağ
/// (plain String, FK yok → Case/Doctor modelleri değişmez). Onaylanınca mevcut /consult akışı yürütür.
model ConsultAppointment {
  id             String    @id @default(cuid())
  caseId         String    @unique // her vaka için tek aktif randevu akışı
  patientId      String? // vaka sahibi (User.id) — bildirim hedefi
  branch         String
  doctorId       String? // teklif veren İcapçı (Doctor.id)
  proposedAt     DateTime? // önerilen randevu zamanı (OFFERED)
  status         String    @default("REQUESTED") // REQUESTED | OFFERED | CONFIRMED | CHANGE_REQUESTED | CANCELLED
  consultationId String? // CONFIRMED + hasta katılınca oluşan Consultation.id
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([branch, status])
}

/// Sağlık turizmi ilk-temas (2026-07-14): branş havuzundaki doktor → hastaya tanıtım mesajı
/// + opsiyonel video randevu teklifi. ÇOKLU doktor aynı tourism-Case'e outreach yapabilir; hasta
/// bekleme ekranında hepsini görür, bir video teklifini kabul eder → ConsultAppointment (CONFIRMED)
/// + görüşme. Görüşme sonrası mevcut tedavi kararı → acente → escrow zinciri aynen sürer (ilk-temas
/// katmanı; zincir bozulmaz). message PHI değil (doktor tanıtımı) → düz metin.
model TourismOutreach {
  id             String    @id @default(cuid())
  caseId         String // tourism-Case (Case.id, journey=HEALTH_TOURISM)
  doctorId       String // outreach yapan branş doktoru (Doctor.id)
  message        String // doktorun tanıtım mesajı
  proposedAt     DateTime? // önerilen video görüşme zamanı; null = yalnız mesaj
  status         String    @default("SENT") // SENT | ACCEPTED | DECLINED | CANCELLED
  consultationId String? // ACCEPTED + görüşme başlayınca oluşan Consultation.id
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([caseId])
  @@index([doctorId, status])
}

/// Sağlık turizmi paketi rezervasyonu (Modül 3)
model Booking {
  id                   String   @id @default(cuid())
  case                 Case     @relation(fields: [caseId], references: [id])
  caseId               String
  branch               String
  country              String
  tier                 String // Ekonomik, Standart, Premium
  hotelStars           Int
  hospitalType         String // Özel, Üniversite
  nights               Int
  translator           Boolean  @default(false)
  insuranceExtended    Boolean  @default(false)
  insuranceMalpractice Boolean  @default(false)
  insuranceLevel       Int      @default(1) // M3: 1=zorunlu · 2=+operasyon teminatı · 3=+malpraktis (kümülatif)
  insuranceDetail      String? // JSON InsuranceQuote — teminat tabanı/hedef/boşluk/katman primleri (endikatif; lib/pricing)
  subtotal             Int
  platformFee          Int
  total                Int
  currency             String   @default("USD")
  breakdown            String // JSON LineItem[]
  split                String // JSON LineItem[]
  status               String   @default("CONFIRMED") // DRAFT, CONFIRMED, CANCELLED
  escrowStatus         String   @default("HELD") // HELD, RELEASED, REFUNDED
  journeyData          String? // JSON JourneyStage[] — lojistik Patient Journey (transfer/otel/hastane/operasyon/dönüş; aşama durumu+tarih+not). null → defaultJourney() fallback. lib/journey.ts
  createdAt            DateTime @default(now())

  @@index([caseId, createdAt]) // hasta vaka listesi son-rezervasyon ilişki yükü (take 1, createdAt desc)
}

/// Triyajda hastanın yüklediği tıbbi belge (tahlil/görüntüleme raporu/epikriz/reçete) — içerik + AI ön-değerlendirmesi.
/// İçerik base64 (küçük dosya; gerçek object storage TODO — SO/checkin deseni). DICOM görüntü içeriği saklanmaz
/// (viewer-only; radyoloji AI yorumu kapsam dışı). AI alanları doktor kokpitte "AI ile değerlendir & çevir" ile doldurulur.
model CaseDocument {
  id            String    @id @default(cuid())
  case          Case      @relation(fields: [caseId], references: [id])
  caseId        String
  label         String // dosya adı
  mimeType      String // application/pdf | image/jpeg | image/png | ...
  content       String? // base64 data URI — AI girdisi + orijinal görüntüleme (DICOM/büyük → null)
  // AI ön-değerlendirme (doktor başlatır; assessDocument çıktısı — hepsi Türkçe)
  aiDocType     String? // Laboratuvar | Görüntüleme Raporu | Epikriz / Tıbbi Rapor | Reçete | Diğer
  aiSummary     String? // klinik özet (önemli bulgular + triyaj şikayetiyle ilişki)
  aiTranslation String? // belge içeriğinin Türkçe çevirisi
  aiFlags       String? // anormal/kritik bulgu vurgusu (boş olabilir)
  assessedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([caseId])
}

/// M5 — Hekim mesleki belgesi (diploma, MMSS poliçesi, sertifika, akademik çalışma).
/// Diploma + MMSS ZORUNLU (yüklemeden hesap aktifleşmez); sertifika/akademik ihtiyari.
/// İçerik base64 data URI + at-rest şifreli (CaseDocument deseni; gerçek object storage TODO).
model DoctorDocument {
  id        String   @id @default(cuid())
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  doctorId  String
  type      String // DIPLOMA | MMSS | CERTIFICATE | ACADEMIC
  label     String // dosya adı
  mimeType  String // application/pdf | image/jpeg | image/png | ...
  content   String // base64 data URI — at-rest şifreli (encryptField)
  createdAt DateTime @default(now())
  /// İnceleme durumu (Faz 2, 2026-08-14): PENDING (yüklendi, incelenmedi) | ACCEPTED | REJECTED.
  /// Karar yalnız görünürlük+bildirim içindir — AKTİVASYONA DOKUNMAZ (refreshActivation belge
  /// varlığına bakar; reddedilen tekil belge yenisi yüklenince zaten satırıyla değişir → PENDING).
  status     String  @default("PENDING")
  /// REJECTED gerekçesi (incelemeci yazar, doktora bildirimle gider). ⚖️ Şablon dili v6.91 paketinde.
  reviewNote String?

  @@index([doctorId])
}

/// Post-Op iyileşme takibi (Modül 4)
model Recovery {
  id        String    @id @default(cuid())
  case      Case      @relation(fields: [caseId], references: [id])
  caseId    String    @unique
  branch    String
  status    String    @default("ACTIVE") // ACTIVE, COMPLETED — COMPLETED = post-op erişim daraltma (E2EE Faz 2A): klinik personel erişimi kapanır, hasta-only
  startedAt DateTime  @default(now())
  completedAt DateTime? // post-op takip tamamlandı (manuel kapatma zamanı; otomatik süre-aşımı kapanması hesaplanır, null kalır)
  completedBy String?   // tamamlayan User.id (manuel doktor) — denetim
  reopenedAt  DateTime? // hasta erişimi yeniden açtı (geri-alma, E2EE Faz 2A) — otomatik kapanma penceresi buradan yeniden başlar; null = hiç yeniden açılmadı
  checkIns  CheckIn[]
}

/// Günlük iyileşme kontrolü
model CheckIn {
  id         String   @id @default(cuid())
  recovery   Recovery @relation(fields: [recoveryId], references: [id])
  recoveryId String
  pain       Int // 0-10
  feverC     Float
  meds       Boolean  @default(true)
  note       String?
  photo      String?
  severity   String // NONE, WATCH, RED
  createdAt  DateTime @default(now())

  @@index([recoveryId, createdAt]) // post-op panelleri ilişki yükü (createdAt desc, take 1) — satırlar foto taşır, ağır tablo
}

/// WebRTC sinyalleşme mesajı (video görüşme — polling tabanlı)
model Signal {
  id             Int      @id @default(autoincrement())
  consultationId String
  sender         String // "doctor" | "patient"
  kind           String // "offer" | "answer" | "ice" | "bye"
  data           String // JSON
  createdAt      DateTime @default(now())

  @@index([consultationId, id]) // poll cursor'ı (id > after, orderBy id asc) — eski tekli [consultationId] bu prefix'le kapsanır
}

/// Etik Kurul / Tahkim başvurusu (Modül 7)
model Complaint {
  id          String    @id @default(cuid())
  case        Case      @relation(fields: [caseId], references: [id])
  caseId      String
  bookingId   String? // ilgili rezervasyon (iade için)
  subject     String
  description String
  requestType String // REFUND, DOCTOR_CHANGE, HOSPITAL_CHANGE, OTHER
  // Hastanın bildirdiği ilgili/karşı taraf (v6.79) — kurulun savunma/bilgi talebi bu tarafa
  // yönlenir (lib/system-messages resolveDefenseTarget). Kurul kimlik DEĞİL yalnız tipi görür.
  respondentType String? // DOCTOR | AGENCY | HOSPITAL | OTHER
  evidence    String?
  status      String    @default("PENDING") // PENDING, RESOLVED
  // Kurul kararı
  verdict      String? // FAVOR, PARTIAL, REJECT
  action       String? // REFUND_FULL, REFUND_PARTIAL, SUPPLIER_CHANGE, ACCREDITATION_WARN, NONE
  refundAmount Int?
  rationale    String?
  decidedBy    String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
}

/// Güvenli dijital sağlık paylaşımı linki (Modül 4 — hasta kontrolünde veri paylaşımı)
/// Hasta, kendi verisini süreli/iptal edilebilir bir token-linki ile yurt dışındaki doktoruna paylaşır.
model ShareLink {
  id            String        @id @default(cuid())
  token         String        @unique // URL token — girişsiz erişim anahtarı
  case          Case          @relation(fields: [caseId], references: [id])
  caseId        String
  recipientName String? // hastanın girdiği alıcı adı, ör. "Dr. Smith" (ops.)
  scopes        String // CSV kategori: EPIKRIZ,RADYOLOJI,LAB,GORUSME_NOTU
  expiresAt     DateTime? // null = süresiz
  passwordHash  String? // opsiyonel erişim şifresi (bcrypt)
  allowDownload Boolean       @default(false)
  revokedAt     DateTime? // iptal edildiyse zaman damgası
  accesses      ShareAccess[]
  createdAt     DateTime      @default(now())

  @@index([caseId])
}

/// Uygulama içi bildirim — rol hedefli (yayın) VEYA kullanıcı hedefli (kişisel)
model Notification {
  id        String    @id @default(cuid())
  role      String? // hedef rol: PATIENT, DOCTOR, COORDINATOR, ETHICS, ADMIN (yayın)
  userId    String? // hedef kullanıcı (kişisel — vaka sahibi hasta vb.)
  type      String // NEW_CASE, RED_FLAG, BOOKING, COMPLAINT, DECISION, SHARE_ACCESS
  title     String
  body      String?
  href      String? // tıklayınca gidilecek sayfa
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([role, readAt])
  @@index([userId, readAt])
}

/// Sistem mesajı (v6.79) — bildirimden farkı: İÇERİKLİ ve iş-akışına bağlı (talep→yanıt),
/// header menüsünde kendi bölümü + /mesajlar sayfası var. İlk kullanım: etik kurulun karşı
/// taraftan savunma/bilgi talebi (kind=DEFENSE_REQUEST). Hedefleme Notification ile aynı:
/// rol yayını (role) VEYA kişisel (userId). body/reply at-rest ŞİFRELİ (encryptField) —
/// subject düz metindir, bu yüzden SABİT ŞABLON + maskCaseId taşır, serbest metin girmez.
model SystemMessage {
  id              String    @id @default(cuid())
  role            String? // hedef rol yayını: COORDINATOR, AGENCY, ...
  userId          String? // kişisel hedef (ör. atanmış doktorun kullanıcı hesabı)
  kind            String // DEFENSE_REQUEST (ileride: ANNOUNCE vb.)
  subject         String // düz — sabit şablon + maskCaseId (PHI/serbest metin YASAK)
  body            String // ŞİFRELİ — talep metni (decryptField ile okunur)
  threadKey       String? // süreç bağı, ör. "complaint:<id>" — kilit/geçmiş sorguları bununla
  needsReply      Boolean   @default(false)
  reply           String? // ŞİFRELİ — karşı tarafın tek yanıtı
  repliedAt       DateTime?
  repliedByUserId String? // yanıtlayan hesap — kurul yüzüne ASLA çıkmaz (anonimlik)
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([role, readAt])
  @@index([userId, readAt])
  @@index([threadKey]) // defenseLockState + kurul paneli geçmişi
}

/// Arayüz çeviri önbelleği — TR kaynak metin → hedef dil (Claude ile bir kez çevrilir, sonsuza dek cache)
model Translation {
  id         String   @id @default(cuid())
  lang       String // hedef dil (Türkçe adıyla: "Rusça", "Arapça", ...)
  sourceHash String // sha1(kaynak) — uzun metinler için anahtar
  source     String // Türkçe kaynak metin
  translated String // çeviri
  createdAt  DateTime @default(now())

  @@unique([lang, sourceHash])
}

/// Web Push aboneliği — kullanıcının cihazı (tarayıcı kapalıyken bildirim)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String // abone kullanıcı
  role      String // abonelik anındaki rol (rol yayını hedeflemesi)
  endpoint  String   @unique // push servisi adresi (FCM/APNs/Mozilla)
  p256dh    String // istemci açık anahtarı
  auth      String // kimlik doğrulama sırrı
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([role])
}

/// Paylaşım linkine erişim kaydı — Denetim İzi (Audit Trail)
model ShareAccess {
  id            String    @id @default(cuid())
  shareLink     ShareLink @relation(fields: [shareLinkId], references: [id])
  shareLinkId   String
  action        String // VIEW, DOWNLOAD
  ip            String?
  userAgent     String?
  detail        String? // indirilen dosya adı vb.
  seenByPatient Boolean   @default(false) // hasta erişim bildirimini gördü mü
  createdAt     DateTime  @default(now())

  @@index([shareLinkId])
}

/// ───────────────────────────────────────────────────────────────────────────
/// İkinci Görüş (Second Opinion) Modülü — boundary spec §4 (state machine) / §6
/// Mevcut genel triyaj akışından BAĞIMSIZ paralel akış. Kesişen altyapı
/// (auth, Notification, video Consultation, Translation, audit deseni) reuse edilir.
/// patientId / assignedDoctorId — Case.userId deseni gibi gevşek bağ (plain String,
/// FK relation YOK → User/Doctor modelleri değiştirilmez). Durum/tip string'leri
/// lib/second-opinion + data/second-opinion-docs ile eşleşir.
/// ───────────────────────────────────────────────────────────────────────────

/// Tek bir ikinci görüş talebi = bir vaka (§1). 11-durumlu yaşam döngüsü (§4).
model SecondOpinionCase {
  id               String  @id @default(cuid())
  patientId        String // vaka sahibi hasta (User.id)
  branch           String // 30 branştan biri (lib/triage BRANCHES.key)
  diagnosisSummary String // hastanın mevcut tanı özeti (serbest metin)
  country          String? // hasta ülkesi (COUNTRIES.code) — veri ikametgâhı/yönlendirme sinyali (geo-routing)
  language         String? // hastanın tercih ettiği iletişim dili (LANGUAGES) — eşleştirme + sunum dili
  patientPhone      String? // hasta telefonu (kimlik → at-rest şifreli, encryptField) — 2026-07-10
  contactPreference String? // hastanın iletişim tercihi: APP | SMS | EMAIL
  status           String  @default("DRAFT") // bkz. lib/second-opinion SO_STATUSES
  assignedDoctorId String? // atanan hekim (Doctor.id) — §10: tek doktor
  // SLA zaman damgaları — hesap TEK KAYNAK lib/second-opinion (§11)
  consentAt          DateTime? // KVKK açık rıza (§8) — başvuru başında alınır
  paidAt             DateTime? // peşin ödeme onayı
  readyAt            DateTime? // READY_FOR_ASSIGNMENT — yazılı rapor SLA başlangıcı
  assignedAt         DateTime?
  opinionDeliveredAt DateTime? // video penceresi (15 gün) başlangıcı
  closedAt           DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  // Hesap silme (v6.11) — Case ile AYNI kural: kayıt saklanır, erişim kapanır, süre sonunda imha edilir.
  // SO vakası ayrı bir PHI deposudur (tanı özeti + belgeler + rapor) → silme akışı ikisini birlikte kilitler.
  deletionLockedAt   DateTime?
  purgeAfter         DateTime?

  documents   SecondOpinionDocument[]
  requests    SecondOpinionRequest[]
  opinion     SecondOpinion?
  appointment SecondOpinionAppointment?
  payment     SecondOpinionPayment?
  events      SecondOpinionEvent[]

  @@index([patientId])
  @@index([purgeAfter]) // imha cron'u
  @@index([assignedDoctorId])
  @@index([status, branch]) // lazy fan-out havuzu (OFFERED + branş) — eşitlik/IN status sorguları prefix'ten yararlanır (notIn yararlanmaz)
}

/// Vakaya bağlı tıbbi belge (§6, §6.5). DICOM (IMAGING) harici link olarak tutulur;
/// diğerleri küçük dosya → base64 (gerçek object storage TODO, §8/§9.2).
model SecondOpinionDocument {
  id             String            @id @default(cuid())
  case           SecondOpinionCase @relation(fields: [caseId], references: [id])
  caseId         String
  type           String // EPICRISIS | IMAGING | PATHOLOGY | MEDICATION_LIST
  deliveryMethod String // FILE_UPLOAD | EXTERNAL_LINK
  fileRef        String? // base64 veri-URI (küçük dosya; object storage gelince değişir)
  externalRef    String? // DICOM / bulut linki (IMAGING)
  label          String? // dosya adı / açıklama
  uploadedBy     String // User.id
  uploadedAt     DateTime          @default(now())

  @@index([caseId])
}

/// Hasta talebi — Talep A (eksik belge) ve Talep B (ek tetkik) aynı varlığın iki tipi (§3.1/§6).
model SecondOpinionRequest {
  id          String            @id @default(cuid())
  case        SecondOpinionCase @relation(fields: [caseId], references: [id])
  caseId      String
  type        String // MISSING_DOCUMENT (Talep A) | ADDITIONAL_EXAMINATION (Talep B)
  description String
  requestedBy String // "coordinator" | "doctor"
  requestedById String? // işlemi açan User.id (audit)
  status      String            @default("PENDING") // PENDING | FULFILLED
  createdAt   DateTime          @default(now())
  fulfilledAt DateTime?

  @@index([caseId])
}

/// Yazılı ikinci görüş (§6). İçerik yapılandırılmış metin; çok dilli sunum Translation ile.
model SecondOpinion {
  id          String            @id @default(cuid())
  case        SecondOpinionCase @relation(fields: [caseId], references: [id])
  caseId      String            @unique
  doctorId    String
  content     String // yazılı görüş tam metni
  structured  String? // JSON bölümler (opsiyonel)
  attachments String?
  submittedAt DateTime          @default(now())
}

/// Video randevusu (§6). Görüşmeyi mevcut video altyapısı yürütür; burada yalnız randevu + referans.
model SecondOpinionAppointment {
  id               String            @id @default(cuid())
  case             SecondOpinionCase @relation(fields: [caseId], references: [id])
  caseId           String            @unique
  patientId        String
  doctorId         String
  scheduledAt      DateTime
  proposedSlots    Json? // basitleştirme Faz 3: doktorun önerdiği 2-3 alternatif zaman (ISO dizisi) — hasta tek tıkla seçer; null = tek-zaman teklifi (eski davranış)
  externalVideoRef String? // mevcut video altyapısına referans (Consultation.id) — Faz 4
  status           String            @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED
  createdAt        DateTime          @default(now())
}

/// Peşin ödeme (§6/§11). 600 USD tek ödeme; kart verisi modülde TUTULMAZ. Şimdilik simüle
/// (gerçek gateway TODO). İade politikası PARK (§9.1) → REFUNDED durumu ileride kullanılır.
model SecondOpinionPayment {
  id          String            @id @default(cuid())
  case        SecondOpinionCase @relation(fields: [caseId], references: [id])
  caseId      String            @unique
  amount      Int               @default(600) // USD (§11)
  currency    String            @default("USD")
  status      String            @default("PENDING") // PENDING | PAID | REFUNDED | FAILED
  providerRef String? // simüle ödeme referansı
  paidAt      DateTime?
  createdAt   DateTime          @default(now())
}

/// Denetim izi (§8) — her durum geçişi + belge erişimi (kim/ne zaman). Spec'in çekirdek
/// varlıkları arasında yok ama §8 NFR'si zorunlu kılıyor → eklendi.
model SecondOpinionEvent {
  id        String            @id @default(cuid())
  case      SecondOpinionCase @relation(fields: [caseId], references: [id])
  caseId    String
  actorId   String? // işlemi yapan (User.id); sistem ise null
  actorRole String?
  action    String // STATUS_CHANGE | DOC_UPLOAD | DOC_VIEW | REQUEST_OPEN | REQUEST_FULFILL | OPINION_SUBMIT | PAYMENT | ASSIGN | VIDEO
  detail    String? // ör. "DRAFT→AWAITING_PAYMENT"
  createdAt DateTime          @default(now())

  @@index([caseId])
}

/// Değiştirilemez erişim denetim kaydı (E2EE Faz 0 — "sıkı erişim kontrolü + audit").
/// Klinik veriye her ANLAMLI erişim (okuma/yazma/dışa aktarım) burada mühürlenir: kim/ne zaman/hangi kayıt.
/// v2.72 onam deseni birebir: append-only hash-zinciri (prevHash→entryHash) + (test) RFC 3161 zaman damgası.
/// Yüksek-frekanslı mekanik olaylar (signal polling, i18n, notifications) KASITLI dışarıda (flood önleme).
/// Mevcut tablolara dokunmaz → gevşek String bağlar (FK yok). lib/audit.ts ile yazılır/doğrulanır.
model AccessLog {
  id            String    @id @default(cuid())
  actorId       String? // erişen kullanıcı (User.id); sistem ise null
  actorRole     String? // erişim anındaki rol (snapshot)
  action        String // CASE_VIEW | CONSULT_WRITE | CONSULT_END | FHIR_EXPORT | DOCUMENT_VIEW ...
  resourceType  String // CASE | CONSULTATION | FHIR_COMPOSITION | FHIR_CONSENT | CASE_DOCUMENT ...
  resourceId    String // erişilen kaydın id'si
  subjectUserId String? // verinin sahibi hasta (User.id) — "verime kim erişti" görünümü için
  detail        String? // ek bağlam (alan / uç nokta)
  ip            String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  // İspat & bütünlük (v2.72 deseni): append-only hash-zinciri + (test) RFC 3161 zaman damgası
  prevHash    String? // önceki kaydın entryHash'i (GENESIS = ilk)
  entryHash   String? // SHA-256(actorId|action|resourceType|resourceId|subjectUserId|createdAt|prevHash) — bu kaydın mührü
  tsAuthority String? // zaman damgası otoritesi (şimdilik SIMULATED-LOCAL)
  tsTime      DateTime? // TSA'nın güvenilir zamanı
  tsToken     String? // imzalı zaman damgası token'ı (entryHash üzerinde)

  @@index([subjectUserId, createdAt])
  @@index([resourceType, resourceId])
  @@index([actorId])
  @@index([createdAt, id]) // zincir tip sorgusu (her append, advisory-lock altında) + verify tam yürüyüş + denetim sayfalaması
}

/// HealthTürkiye (healthturkiye.gov.tr) doktor kayıt defteri — günlük senkron (2026-07-10).
/// Kaynak: web-api.healthturkiye.gov.tr/api/v1/doctor/search (sayfalı; ~10.000 kayıt). PHI DEĞİL —
/// kamuya açık resmi dizin (şifreleme yok). Soft-delete: kaynaktan kalkan kayıt removedAt damgalanır
/// (silinmez) → günlük eklenen/çıkarılan raporu + doktor kayıt doğrulaması buradan.
model RegistryDoctor {
  id                Int       @id // kaynak kayıt id'si (healthturkiye)
  name              String
  lastName          String
  jobName           String? // Meslek (Professor, Associate Professor, Specialist ...)
  jobId             Int?
  branchName        String? // Branş (kaynak dili EN)
  branchId          Int?
  cityId            Int?
  cityName          String? // Şehir (GET /city lookup'ından doldurulur)
  establishmentId   Int?
  establishmentName String? // Hastane / kurum
  slug              String?
  address           String?
  experience        Int?
  genderId          Int?
  fingerprint       String? // liste-API alanlarının kısa hash'i (v5.4 alan-güncelleme; null = backfill bekliyor)
  firstSeenAt       DateTime  @default(now()) // dizinde ilk görüldüğü senkron
  lastSeenAt        DateTime  @default(now()) // son görüldüğü senkron
  removedAt         DateTime? // kaynaktan çıkarıldığı senkron (null = halen kayıtlı)

  @@index([branchId]) // Branş filtresi
  @@index([cityId]) // Şehir filtresi
  @@index([establishmentId]) // Hastane filtresi
  @@index([jobId]) // Meslek filtresi
  @@index([removedAt]) // aktif/çıkarılmış ayrımı
  @@index([lastName, name]) // kayıt doğrulama (ad-soyad eşleşmesi)
}

/// HealthTürkiye sağlık tesisi kayıt defteri — günlük senkron (2026-07-10).
/// Kaynak: /api/v1/establishment/search (~4.600 tesis). Tedavi kararındaki hastane seçici buradan.
/// languages/accreditations/facilities liste API'sinde yalnız sayı olarak var → JSON alanlar detay
/// zenginleştirmesiyle (establishment-detail) aşamalı dolar; boş = henüz zenginleştirilmedi.
model RegistryHospital {
  id                 Int       @id // kaynak kayıt id'si
  name               String
  slug               String?
  cityName           String? // Şehir
  cityCode           String?
  cityHasAirport     Boolean? // Havalimanı filtresi
  address            String?
  phone              String?
  totalPersonnel     Int? // Minimum Sağlık Profesyoneli Sayısı filtresi
  unitCapacity       Int?
  facilityTypeId     Int?
  facilityTypeName   String? // Sağlık Tesisi Türü / Tesis Çeşidi (Facility Type)
  accreditationCount Int? // Akreditasyonlar (sayı; adlar detay zenginleştirmesiyle)
  certificationCount Int?
  insuranceCount     Int?
  doctorCount        Int?
  foundationYear     Int?
  latitude           String?
  longitude          String?
  branches           String? // JSON [{id,name}] — Branş filtresi
  treatments         String? // JSON — hizmet verilen tedaviler
  languages          String? // JSON — Hizmet Verilen Diller (detay zenginleştirme)
  accreditations     String? // JSON — akreditasyon adları (detay zenginleştirme)
  facilities         String? // JSON — Tesis Olanakları (detay zenginleştirme)
  authorizationNumber String? // Sağlık turizmi YETKİ BELGE NO (ör. "ST-0292"; detaydan — "" = kontrol edildi, dizinde belge yok; null = henüz bakılmadı)
  fingerprint        String? // liste-API alanlarının kısa hash'i (v5.4 alan-güncelleme; detay/enrichment alanları DAHİL DEĞİL)
  firstSeenAt        DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())
  removedAt          DateTime? // kaynaktan çıkarıldığı senkron (null = halen kayıtlı)

  @@index([cityCode]) // Şehir filtresi
  @@index([facilityTypeId]) // Tesis türü filtresi
  @@index([removedAt])
}

/// Günlük registry senkron raporu — doktor + hastane değişimleri TEK raporda (2026-07-10).
/// Cron her koşuda o günün kaydını yazar; eklenen/çıkarılan listeleri JSON özet olarak tutulur.
model RegistryReport {
  id               String   @id @default(cuid())
  date             String   @unique // YYYY-MM-DD (Europe/Istanbul günü) — günde tek rapor (yeniden koşu üzerine yazar)
  status           String   @default("OK") // OK | FETCH_FAILED | PARTIAL
  doctorsTotal     Int      @default(0) // senkron sonunda aktif doktor sayısı
  hospitalsTotal   Int      @default(0)
  updatedDoctors   Int      @default(0) // alan-güncellemesi yapılan kayıt sayısı (v5.4 fingerprint)
  updatedHospitals Int      @default(0)
  addedDoctors     String? // JSON [{id,name,lastName,branchName,cityName,establishmentName}]
  removedDoctors   String? // JSON — aynı biçim
  addedHospitals   String? // JSON [{id,name,cityName,facilityTypeName}]
  removedHospitals String? // JSON — aynı biçim
  detail           String? // hata/bilgi notu (FETCH_FAILED nedeni, kısmi sayfa vb.)
  createdAt        DateTime @default(now())

  @@index([createdAt]) // rapor listesi (yeni→eski)
}

/// Doctorium — hekim bilgi portalı yayın kaydı (v6.48).
/// Günlük bakım cron'u (purge-deleted) kaynakları tarar ve BURAYA yazar; sayfa DB'den okur
/// (istek-anında dış API'ye gitmez → hızlı + NCBI'ya nazik + arama/filtre mümkün).
/// İçerik HERKESE AÇIK literatür/mevzuattır — PHI DEĞİLDİR, şifrelenmez (bilinçli).
model NewsArticle {
  id            String   @id @default(cuid())
  source        String // "pubmed" | "resmi-gazete" | "titck" | ... (kaynak sistemi)
  externalId    String // pmid / rss guid — kaynak içinde benzersiz (yeniden çekimde tekrar yazılmaz)
  module        String // "akademik" | "mevzuat" | "sektorel" | "ilac" (v6.50: mevzuat/sektörel/ilaç ayrıştı)
  /// Sektörel alt kategori (v6.50) — yalnız module="sektorel"/"mevzuat"/"ilac" için:
  /// "mevzuat" | "sut" | "turizm" | "yonetim" | "teknoloji" | "ilac-cihaz". null = kategorisiz.
  category      String?
  /// JSON string[] — ilgili branş SLUG'ları (lib/triage BRANCHES key'leri). Boş dizi = genel akış.
  branchSlugs   String   @default("[]")
  kind          String // makale | ilac | mevzuat | haber
  title         String // gösterim başlığı (çevrilmişse Türkçe)
  titleOriginal String? // özgün dildeki başlık (çeviri uygulandıysa)
  summary       String // özet/abstract (çevrilmişse Türkçe)
  /// AI klinik özet — JSON {takeaways: string[], design: string, limits: string}. Null = henüz üretilmedi.
  /// ⚠️ Klinik karar aracı DEĞİL; arayüzde bu uyarı ile birlikte gösterilir.
  aiSummary     String?
  sourceName    String // dergi/kurum adı (JAMA · Resmî Gazete ...)
  authors       String? // "Yılmaz A, Chen B, ve ark."
  url           String? // kalıcı adres (DOI varsa doi.org)
  doi           String?
  /// v6.99.2 — kaynak sayfanın kendi görseli (og:image / RSS media). YALNIZ NEWS_IMAGE_HOSTS
  /// allowlist'inden yazılır (CSP img-src ile sözleşme testli); hotlink — görsel BARINDIRILMAZ.
  /// null = üretilmiş kapak (CoverArt). Detay sayfasında kaynak atfıyla gösterilir.
  imageUrl      String?
  publishedAt   DateTime
  createdAt     DateTime @default(now())

  @@unique([source, externalId]) // idempotent ingestion
  @@index([module, publishedAt]) // modül akışı (yeni→eski)
}

/// Doctorium Modül E — medikal kongre takvimi (v6.48; v6.62'de KÜRATÖRLÜ VERİTABANI'na genişledi).
/// Otomatik kaynak YOK (dernek/kongre siteleri makine-okunur takvim yayımlamıyor) → küratörlü:
/// 30 branşın ulusal + uluslararası kongreleri resmî sitelerinden doğrulanarak derlendi
/// (vault `output/kongre-veritabani-2026-08-03.md`; seed `scripts/seed-congresses.ts`).
/// ⚠️ Bilinmeyen alan BOŞ bırakılır — kongre verisi asla tahmin edilmez (uydurma tarih = yanlış
/// bildiri/kayıt alarmı = doktorun gerçek kaybı).
model MedicalCongress {
  id                String    @id @default(cuid())
  title             String
  organizer         String? // düzenleyen dernek/kurum
  city              String?
  country           String    @default("TR")
  startDate         DateTime
  endDate           DateTime?
  abstractDeadline  DateTime? // bildiri son teslim
  earlyBirdDeadline DateTime? // erken kayıt son gün
  url               String?
  /// JSON string[] — ilgili branş slug'ları (boş = tüm branşlar).
  branchSlugs       String    @default("[]")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // ── v6.62 küratörlü veritabanı alanları ───────────────────────────────────
  /// Kaynak kimliği — idempotent seed/tazeleme için. Elle girilen kayıtlarda null kalır
  /// (bu yüzden nullable + kompozit unique: null'lar Postgres'te çakışmaz).
  source            String?
  externalId        String?
  /// "ulusal" | "uluslararasi" — doktorun ilk süzdüğü eksen (v6.62 filtre).
  scope             String    @default("ulusal")
  /// Kaçıncı edisyon ("42.", "XXVII.") — ad ile ayrı tutulur ki yıl değişince ad bozulmasın.
  edition           String?
  /// "yillik" | "2-yilda-bir" | null(bilinmiyor) — tazeleme kademesi bunu kullanır.
  frequency         String?
  /// Mekân/otel ("Susesi Kongre Merkezi, Belek") — şehirden ayrı: doktor konaklamayı buna göre seçer.
  venue             String?
  /// "yuz-yuze" | "hibrit" | "online" — online ücret çok daha ucuz olabiliyor (ESC 995€ → 255€).
  format            String?
  /// Kongre dili + çeviri notu ("Türkçe" / "İngilizce, simultane TR çeviri").
  language          String?
  /// TTB-STE / CME kredi notu — TR kongrelerinin çoğu kredili, doktorun birincil karar kriteri.
  cmeCredit         String?
  /// Kayıt ücretleri + koşulları (serbest metin; kategori × kademe tabloları buraya düz yazılır).
  registrationNotes String?
  /// Ana temalar / öne çıkan başlıklar. Tam PROGRAM taşınmaz (telif + kongreden 1-2 ay önce
  /// kesinleşir → bayat bilgi riski); doktor programa resmî siteden gider.
  themes            String?
  /// ⚠️ Doktora gösterilecek uyarı — ör. sahte kayıt sitesi ihbarı (ERA · IDWeek · EPA resmî
  /// uyarı yayımlıyor). Doldurulmuşsa kartta GÖRÜNÜR şekilde basılır.
  warning           String?
  /// Kapak görseli — kongrenin og:image'ı yerel script'le indirilip sharp'la ~320px webp'e
  /// YENİDEN encode edilir ve data URI olarak buraya yazılır (scripts/fetch-congress-covers.ts).
  /// CSP `img-src 'self' data:` dış hostu engeller, data: izinli; re-encode aktif içeriği söker.
  /// ⚠️ Data URI ~5-20KB/kayıt → LİSTE sorguları bu alanı SELECT ETMEZ (upcomingCongresses +
  /// admin listesi açık select'li). Yoksa UI branş amblemli üretilmiş kapak çizer.
  coverImage        String?
  /// JSON string[] — doğrulamada kullanılan kaynak URL'leri (şeffaflık: "bunu nereden biliyoruz").
  sourceUrls        String    @default("[]")
  /// "dogrulandi" | "kismi" — kısmi = sonraki edisyon henüz ilan edilmemiş ya da ikincil kaynak.
  confidence        String    @default("dogrulandi")
  /// Son doğrulama tarihi — tazeleme döngüsü ve "şu tarihte teyit edildi" ibaresi için.
  verifiedAt        DateTime?

  @@unique([source, externalId]) // idempotent seed/tazeleme (elle kayıtlarda null → çakışmaz)
  @@index([startDate])
  @@index([scope, startDate]) // ulusal/uluslararası filtresi + tarih sıralaması
}

/// Doctorium Modül E — hekimin TAKİP ettiği kongre (v6.49). Takip = alarm kapsamına girer.
/// Ayrı tablo (Doctor'da JSON değil): cron "yaklaşan kongreyi takip eden hekimler" sorgusunu
/// bununla kurar; JSON'da her hekimi tarayıp parse etmek gerekirdi.
model CongressFollow {
  id         String   @id @default(cuid())
  doctorId   String
  congressId String
  /// Bu takip için gönderilmiş hatırlatma türleri (JSON string[]: "start" | "deadline") —
  /// aynı alarmın her gün tekrar gönderilmesini önler (kolonsuz tekrar-koruması yerine açık kayıt).
  sentAlerts String   @default("[]")
  createdAt  DateTime @default(now())

  @@unique([doctorId, congressId])
  @@index([congressId])
}

/// Doctorium "Kaydettiklerim" (Faz 2, 2026-08-14) — doktorun işaretlediği içerikler.
/// CongressFollow deseninin kopyası: ilişkisiz düz id'ler + unique çift (kod-level join).
/// Puan ÜRETMEZ (ödül ekonomisinden bilinçli ayrık — "kaydet-farm" olmasın); öğrenci-sınırlı
/// üye de kaydedebilir (içerik işlevi, pazarlama yüzeyi değil).
model SavedArticle {
  id        String   @id @default(cuid())
  doctorId  String
  articleId String
  createdAt DateTime @default(now())

  @@unique([doctorId, articleId])
  @@index([doctorId, createdAt]) // Kaydettiklerim listesi (yeni→eski)
}

/// Doctorium sponsorlu içerik kampanyası (v6.68 Faz 1) — yalnız İLAÇ-DIŞI reklamverenler.
/// Beşeri tıbbi ürün tanıtımı BİLİNÇLİ kapsam dışı: Modül D parkı sürüyor (TİTCK tanıtım
/// yönetmeliği + aracı sıfatı hukuki görüş ister — lib/doctorium.ts başlık notu). Kategoriye
/// CIHAZ dahil (kullanıcı kararı 2026-08-04; Tıbbi Cihaz Satış, Reklam ve Tanıtım Yönetmeliği
/// uyum beyanı reklamverende — çerçeve sözleşme taslağı vault output'ta).
/// KVKK minimizasyon: kişi-bazlı gösterim logu YOK — yalnız kampanya-düzeyi agregat sayaçlar;
/// reklamverene kullanıcı verisi gitmez. Hedefli seçim yalnız Doctor.sponsorPersonalizationAt
/// dolu (açık rızalı) doktorlarda; rızasıza hedefsiz (bağlamsal) kampanyalar gösterilir.
model SponsorCampaign {
  id             String   @id @default(cuid())
  sponsor        String // reklamveren tüzel kişi adı — kartta "Sponsorlu · <sponsor>" olarak açıkça görünür
  category       String // KONGRE | SIGORTA | YAZILIM | CIHAZ | ISE_ALIM | DIGER (İLAÇ YOK — Faz 4 parkı)
  title          String
  body           String
  linkUrl        String? // dış bağlantı; tıklama /api/sponsor/click üzerinden sayılır (rel="sponsored")
  linkLabel      String? // düğme metni (boş = "Ayrıntılar")
  targetBranches String? // JSON string[] branş slug — null/boş = BAĞLAMSAL kampanya (herkese, rıza gerekmez)
  targetCities   String? // JSON string[] şehir adı — yalnız açık-rızalı doktorda uygulanır
  startsAt       DateTime
  endsAt         DateTime
  status         String   @default("DRAFT") // DRAFT | ACTIVE | PAUSED | ENDED
  impressions    Int      @default(0) // agregat render sayacı (kişisiz)
  clicks         Int      @default(0) // agregat tıklama sayacı (kişisiz)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, startsAt, endsAt])
}

/// Doctorium anketi (v6.69 Faz 2) — TEK SORULU (Doximity poll deseni; çok-sorulu Sermo tipi
/// Faz 2b'de ayrı SurveyQuestion tablosuyla genişler — YAGNI). İki tür:
///  - COMMUNITY: içerik rejimi — akış branş süzmesi (haber akışıyla aynı; pazarlama rızası GEREKMEZ).
///  - SPONSORED: pazarlama rejimi — sponsorlu kart kurallarıyla aynı (hedefli seçim yalnız açık
///    rızalı doktora; hedefsiz herkese; sponsor kimliği kartta açık).
/// ⚠️ honorarium > 0 anket ACTIVE EDİLEMEZ (API fail-closed kilidi): ödeme/vergi kurgusu (gider
/// pusulası ↔ SM makbuzu · GİB özelgesi · kamu hekimi) kullanıcı kararı bekliyor — kurgu yokken
/// "ödenir" vaadi verilmez. Alan şemada hazır ki kurgu netleşince migration gerekmesin.
/// Sonuçlar sponsora/ekrana yalnız TOPLU dağılım olarak çıkar (kimlikli tekil yanıt paylaşılmaz).
model Survey {
  id             String   @id @default(cuid())
  kind           String   @default("COMMUNITY") // COMMUNITY | SPONSORED
  sponsor        String? // SPONSORED'da zorunlu (API doğrular) — kartta "Sponsorlu · <sponsor>"
  question       String
  options        String // JSON string[] — 2-6 kapalı şık; serbest metin bilinçli YOK (agregat disiplin)
  honorarium     Int? // kuruş; null/0 = ödemesiz. >0 iken ACTIVE kilidi (ödeme kurgusu parkı)
  points         Int      @default(0) // v6.88 ödül puanı — yanıt anında PointEntry'ye bir kez yazılır (0 = puansız; nakit honorarium'dan AYRI ve ondan bağımsız)
  targetBranches String? // JSON string[] branş slug — COMMUNITY'de içerik süzmesi, SPONSORED'da rıza-şartlı hedef
  targetCities   String? // JSON string[] — yalnız SPONSORED'da anlamlı (rıza-şartlı)
  startsAt       DateTime
  endsAt         DateTime
  status         String   @default("DRAFT") // DRAFT | ACTIVE | PAUSED | ENDED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  responses      SurveyResponse[]

  @@index([status, startsAt, endsAt])
}

/// Anket yanıtı — doktor başına BİR kez (@@unique). Kimlikle saklanır ama YALNIZ mükerrer önleme +
/// (ileride) honorarium hakedişi ispatı için; dışarıya daima agregat çıkar (lib/survey.ts).
model SurveyResponse {
  id          String   @id @default(cuid())
  survey      Survey   @relation(fields: [surveyId], references: [id])
  surveyId    String
  doctorId    String
  optionIndex Int // seçilen şık (options dizisinde 0-tabanlı)
  createdAt   DateTime @default(now())

  @@unique([surveyId, doctorId])
  @@index([surveyId, optionIndex])
}

/// Ödül puanı hareketi (v6.88) — bakiye KOLONU YOK: bakiye = SUM(delta), ledger tek gerçek kaynak
/// (satır silinmez/güncellenmez; her hareket ayrı iz — audit disiplini). Kazanç: anket yanıtı
/// (reason=SURVEY, yanıtla AYNI transaction'da). Harcama: talep ANINDA düşer (REDEEM, delta<0);
/// ret/iptal İADE SATIRI üretir (REDEEM_REFUND, delta>0). ⚠️ Puana parasal değer ATFEDILMEZ
/// (1 puan = ₺X eşlemesi hiçbir yüzeyde kurulmaz); ayni menfaatin vergi/657 değerlendirmesi
/// katalog kalemi girilmeden 👤 yapılır — nakit honorarium kilidi bundan AYRI yaşar.
model PointEntry {
  id           String   @id @default(cuid())
  doctorId     String
  delta        Int // + kazanç / − harcama
  reason       String // SURVEY | REDEEM | REDEEM_REFUND | ADJUST
  surveyId     String? // reason=SURVEY'de dolu — @@unique "aynı anketten iki puan"ı DB seviyesinde keser
  redemptionId String? // REDEEM / REDEEM_REFUND'da dolu
  note         String?
  createdAt    DateTime @default(now())

  @@unique([doctorId, surveyId]) // NULL surveyId (harcama/iade satırları) Postgres'te çakışmaz
  @@index([doctorId, createdAt])
}

/// Ödül kataloğu (v6.88) — BOŞ başlar: ilk kalem girişi ÖNCESİ ayni menfaat değerlendirmesi 👤
/// (vergi + kamu hekimi/657; admin panelde uyarı). İLAÇ sponsorlu kalem GİRİLMEZ (Modül D parkı).
model RewardItem {
  id          String             @id @default(cuid())
  kind        String // KONGRE_TR | KONGRE_INTL | KITAP
  title       String
  description String?
  pointsCost  Int
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  redemptions RewardRedemption[]

  @@index([active, createdAt])
}

/// Ödül talebi (v6.88) — puan TALEP anında rezerve düşer (yarış advisory lock ile serileşir,
/// lib/rewards.ts). İfa DAİMA insan onaylı: REQUESTED → APPROVED → FULFILLED; REJECTED/CANCELLED
/// iade üretir. Otomatik satın alma bilinçli YOK — "vaat → ifa" arasında admin kontrolü.
model RewardRedemption {
  id         String     @id @default(cuid())
  doctorId   String
  item       RewardItem @relation(fields: [itemId], references: [id])
  itemId     String
  pointsCost Int // talep anı bedeli (snapshot — katalog sonradan değişse de sabit)
  status     String     @default("REQUESTED") // REQUESTED | APPROVED | FULFILLED | REJECTED | CANCELLED
  note       String? // doktorun notu (hedef kongre/kitap tercihi)
  adminNote  String? // karar notu — doktora gösterilir
  createdAt  DateTime   @default(now())
  decidedAt  DateTime?

  @@index([status, createdAt])
  @@index([doctorId, createdAt])
}

/// Doctorium Modül F — hekim KARİYER & DENKLİK rehberi (v6.89).
///
/// Otomatik kaynak YOK: resmî otorite siteleri makine erişimine kapalı (2026-08-12 ölçümü —
/// gmc-uk.org HTTP 403, anerkennung-in-deutschland.de 404; TTB/Resmî Gazete ile aynı sınıf)
/// → MedicalCongress ile AYNI küratörlü desen: veri `prisma/seed-data/career-pathways.json`,
/// kaynak belgesi vault `output/kariyer-denklik-veritabani-2026-08-12.md`.
///
/// ⚠️ Bu tablo İDARİ SÜREÇ anlatır; yanlış bilgi hekimin GERÇEK kaybıdır (kaçırılan sınav
/// başvurusu, eksik belge, boşa apostil masrafı). Kurallar: `officialUrl` + `verifiedAt`
/// ZORUNLU (kaynağı olmayan kayıt yazılmaz) · bilinmeyen alan BOŞ bırakılır · süre/ücret
/// ASLA tahmin edilmez (yalnız resmî kaynakta yazan değer).
///
/// ⚖️ İŞ İLANI DEĞİLDİR: başvuru butonu, CV gönderimi, işveren eşleştirmesi YOKTUR. Üyelik
/// arkasında ilan sunmak İŞKUR'a göre "aracılık" sayılır (özel istihdam bürosu izni gerekir)
/// — o faz izin alınana dek açılmaz (envanter §3).
model CareerPathway {
  id            String   @id @default(cuid())
  /// URL segmenti + seed idempotansı ("almanya-approbation").
  slug          String   @unique
  /// "yurtdisi" | "turkiye" — CAREER_TABS anahtarı (lib/doctorium.ts).
  scope         String
  /// ISO 3166 ülke/bölge kodu. ⚠️ BAE'de TEK lisans yoktur: "AE-DU" (Dubai/DHA) ile
  /// "AE-AZ" (Abu Dhabi/DOH) AYRI süreçlerdir — tek "BAE" kaydı yanıltıcı olur.
  country       String
  title         String
  /// Yetkili otorite ("Eyalet ruhsat makamı — Landesprüfungsamt").
  authority     String
  /// 2-3 cümle. Vaat dili YASAK ("alırsınız", "yeterlidir").
  summary       String
  /// JSON [{order,title,detail}] — süreç adımları.
  steps         String   @default("[]")
  /// JSON string[] — belge kontrol listesi.
  documents     String   @default("[]")
  languageReq   String? // "genel B2 + mesleki FSP (~C1)"
  examReq       String? // "FSP; denklik yoksa Kenntnisprüfung"
  /// ⚠️ YALNIZ resmî kaynakta yazan süre yazılır. İkincil kaynaktaki "3-6 ay" bilgisi
  /// null bırakılır — tahmini süre, kaçırılmış plan demektir.
  typicalMonths String?
  costNote      String? // resmî harç varsa; yoksa null (tahmin YOK)
  /// Resmî otorite adresi — ZORUNLU.
  officialUrl   String
  /// JSON string[] — doğrulamada kullanılan diğer kaynaklar ("bunu nereden biliyoruz").
  sourceUrls    String   @default("[]")
  /// "dogrulandi" | "kismi" — kısmi kayıt UI'da "teyit bekliyor" ibaresiyle çıkar.
  confidence    String   @default("dogrulandi")
  /// Son doğrulama tarihi — kullanıcıya GÖRÜNÜR ("Son doğrulama: …"); bayatlık gizlenmez.
  verifiedAt    DateTime
  /// ⚠️ Kartta GÖRÜNÜR uyarı — ör. "eyalete göre değişir" · "Türkiye'de uzman olsanız da bu
  /// statüde asistan maaşı/statüsü uygulanır". Doldurulmuşsa basılır.
  warning       String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([scope, order])
}
